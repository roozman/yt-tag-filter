{
  "manifest_version": 3,
  "name": "YouTube Tag Filter",
  "version": "1.0.0",
  "description": "Only show YouTube videos and Shorts that match your tags.",
  "icons": {
    "128": "icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "YouTube Tag Filter",
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "matcher.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{a30130c6-d136-4b94-bbd7-be74b956667f}",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "115.0"
    }
  }
}
